@model ICollection<Domain.Models.Blog>

@using System.Text.RegularExpressions;

@{
    Domain.Models.Setting xsetting = ViewBag.sxt;
    Domain.Models.SuperSetting supsetting = ViewBag.suppersetting;
    Regex regex = new Regex("[^a-zA-Z0-9]");
}
@if (xsetting.AddBlogToHome == true)
{

  @if (supsetting.TemplateLayoutKey == "Layout8888")
    {

        {
            if (supsetting.BlogTemplateKey == "Blog1111")
            {
                <section class="hm-blog1">
                    <div class="container">
                        <div class="blg-title">
                            <h3>@xsetting.BlogDisplayTitle</h3>
                        </div>

                        <div class="row align-items-center">
                            <div class="col-sm-12">
                                <div class="owl-carousel" data-items="3" data-md-items="2" data-sm-items="1" data-margin="30" data-autoplay="true">
                                    @foreach (var item in Model)
                                    {
                                        <div class="item">
                                            <div class="post style-3">
                                                <div class="post-image">
                                                    <img src="@item.ImageUrl" alt="@item.Title">
                                                </div>
                                                <div class="post-desc">
                                                    <div class="post-date"><i class="fa fa-calendar-check-o"></i> @item.Date.ToString("MMM dd, yyyy")</div>
                                                    <div class="post-title">
                                                        <h5><a asp-page="/Bpg_info" asp-route-id="@item.Id" asp-route-title="@regex.Replace(item.Title, "-")">@item.Title</a></h5>
                                                    </div>
                                                    <p>@item.Description</p>
                                                </div>
                                                <div class="post-bottom">
                                                    <a asp-page="/Bpg_info" asp-route-id="@item.Id" asp-route-title="@regex.Replace(item.Title, "-")" class="post-btn">Read More<i class="ms-2 fas fa-long-arrow-alt-right"></i></a>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            }

        }
    }
 }