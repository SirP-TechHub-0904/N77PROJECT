                                                            <li><a asp-page="/UHSource_Info" asp-route-id="@item.Id" asp-route-title="@regex.Replace(item.Title, "-")">@item.Title</a></li>
                                                        }
                                                    </ul>
                                                }

                                            </li>
                                        }

