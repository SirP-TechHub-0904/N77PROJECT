                                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#">@Model.Setting.BlogDisplayTitle</a>

                                            @{
                                                IEnumerable<Domain.Models.BlogCategory> itemlist = Model.BlogCategory;
                                            }
                                            <ul class="dropdown-menu">

                                                @foreach (var xitem in itemlist.Where(x => x.Publish == true).ToList())
