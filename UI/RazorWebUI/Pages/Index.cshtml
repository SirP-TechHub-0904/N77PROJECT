<!--header end-->
<!--hero section start-->

<section class="banner p-0 position-relative fullscreen-banner">
    <div class="banner-slider owl-carousel no-pb" data-dots="false" data-nav="true">
        @foreach (var item in Model.Slider)
        {
            <div class="item" data-bg-img="@item.Url" data-overlay="6">
                <div class="align-center">
                    <div class="container">
                        <div class="row text-center">
                            <div class="col-lg-10 col-md-12 mx-auto">
                                <h5 class="text-white mb-3 letter-space-3 animated6">@Html.Raw(item.MiniTitle)</h5>
                                <h1 class="text-white mb-3 animated8">@Html.Raw(item.Title)</h1>
                                <p class="lead text-white animated5 mb-3">
                                    @Html.Raw(item.Text)
                                </p>

                                @if (item.ButtonLink == "0")
                                {
                                    <a href="#" class="btn btn-theme btn-radius animated7">@Html.Raw(item.ButtonText)</a>
                                }
                                else if (item.ButtonLink == "000")
                                {
                                    <a asp-page="/Contact" class="btn btn-theme btn-radius animated7">@Html.Raw(item.ButtonText)</a>
                                }
                                else if (item.ButtonLink != "0" && item.ButtonLink == "000")
                                {
                                    <a asp-page="/Source" asp-route-id="@item.ButtonLink" class="btn btn-theme btn-radius animated7">@Html.Raw(item.ButtonText)</a>
                                }

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
</section>
@*section up start*@
@if (Model.SuperSetting.TemplateLayoutKey == "Layout8888")
{
    foreach (var item in Model.PageSectionsTop)
    {

        if (item.TemplateKey == "1")
        {
            <section>
                <div class="container @item.CustomClass">
                    <div class="row text-center">
                        <div class="col-lg-8 col-md-10 mx-auto">
                            <div class="section-title">
                                <h2 class="title">@item.Title</h2>
                                <p class="mb-0">@item.Description</p>
                            </div>
                        </div>
                    </div>
                    <div class="row align-items-center">
                        <div class="col-lg-6 col-md-12">
                            <div class="row">
                                <div class="col-md-12 pe-12">
                                    <div class="about-img mb-0">
                                        <img class="img-fluid" src="@item.ImageUrl" alt="@item.Title">
                                    </div>

                                </div>

                            </div>
                        </div>
                        @foreach (var list in item.PageSectionLists)
                        {
                            <div class="col-lg-6 col-md-12 box-shadow white-bg p-md-4 p-3 mt-5 mt-lg-0">
                                <h5>@list.Title</h5>
                                <p class="line-h-3">@list.Description</p>


                            </div>
                        }
                    </div>
                </div>
            </section>
        }
        else if (item.TemplateKey == "2")
        {
            <section class="dark-bg text-center @item.CustomClass">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-8 col-md-10 mx-auto">
                            <div class="section-title">
                                <h2 class="title">@item.Title</h2>
                                <p class="mb-0 text-white">@item.Description</p>
                            </div>
                        </div>
                    </div>
                    <div class="row">

                        <div class="col-md-12">

                            <div class="owl-carousel" data-items="3" data-md-items="2" data-sm-items="1" data-xs-items="1" data-margin="30">
                                @foreach (var list in item.PageSectionLists)
                                {
                                    <div class="item">
                                        <div class="service-item">
                                            <div class="service-images">
                                                <img class="img-fluid" src="@list.ImageUrl" alt="@list.Title">

                                            </div>
                                            <div class="service-description">
                                                <h4>@list.Title</h4>
                                                <p>@list.Description</p>
                                                @if (isHomePage == true)
                                                {
                                                    if (item.ShowInHome == true && item.DisableButton == false)
                                                    {


                                                        @if (list.ButtonLink == "0")
                                                        {
                                                            <a href="#"><i class="fas fa-arrow-right"></i>@list.ButtonText</a>
                                                        }
                                                        else if (list.ButtonLink == "Direct")
                                                        {
                                                            <a href="@list.DirectUrl"><i class="fas fa-arrow-right"></i>@list.ButtonText</a>
                                                        }
                                                        else if (item.ButtonLink == "00")
                                                        {
                                                            <a asp-page="/Contact"><i class="fas fa-arrow-right"></i>@list.ButtonText</a>
                                                        }
                                                        else
                                                        {
                                                            <a asp-page="/Source" asp-route-id="@item.ButtonLink" asp-route-title="@regex.Replace(item.Title, "-")"><i class="fas fa-arrow-right"></i>@list.ButtonText</a>
                                                        }


                                                    }
                                                }

                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                        </div>

                    </div>
                </div>
            </section>
        }
        else if (item.TemplateKey == "3")
        {
            <section class="grey-bg pattern feuture-bottom white-overlay @item.CustomClass" data-bg-img="@item.ImageUrl" data-overlay="3">
                <div class="container">
                    <div class="row g-0 align-items-center">
                        <div class="col-lg-6 col-md-6 pe-lg-5 md-px-2 text-center">
                            <div class="section-title mb-md-0">
                                <h2 class="title">@item.Title</h2>
                                <p class="mb-0">@item.Description</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="featured-item bottom-icon">
                                <div class="featured-title text-uppercase">
                                    <h5>@item.MiniTitle</h5>
                                </div>
                                <div class="featured-desc">
                                    <p>@item.Qoute</p>
                                </div>

                            </div>
                        </div>
                    </div>
                    <div class="row g-0">
                        @foreach (var list in item.PageSectionLists)
