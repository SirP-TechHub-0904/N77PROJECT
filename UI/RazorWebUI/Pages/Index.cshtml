                                @foreach (var item in Model.Pages.Where(x => x.HomeSortFrom == Domain.Models.EnumStatus.HomeSortFrom.Bottom))
                                {
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">@item.Title</a>

