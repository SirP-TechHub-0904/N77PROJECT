@page
@model RazorWebUI.Areas.Content.Pages.IPages.MediaModel
@{
}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">MEDIA LIST</h3>

 
    </div>
     
    <!-- /.card-header -->
    <div class="card-body">
        <div class="table-responsive">
            <table id="example1" class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>S/N</th>
                        <th>
                            Title
                        </th>
                        <th>
                            Image
                        </th>
                        <th>
                            Size
                        </th>

                        <th>
                            Route
                        </th>
                        <th></th>
                    </tr>
                </thead>


                <tbody>
                    @{
                        int sn = (Model.CurrentPage - 1) * 5;
                    }
                    @foreach (var item in Model.MediaDtos)
                    {
                        <tr>
                            <td>@(++sn)</td>
                            <td>@item.Title</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <a href="@item.ImageUrl" target="_blank">
                                        @*<img src="@item.ImageUrl" style="height:100px;" />*@ @item.ImageUrl
                                    </a>
                                }
                            </td>
                            <td>@item.ImageSize</td>
                            <td>@item.Route</td>
                            <td></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- Pagination -->
        <nav aria-label="Page navigation">
            <ul class="pagination">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-route-page="1">&laquo;&laquo;</a>
                </li>
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-route-page="@(Model.CurrentPage - 1)">&laquo;</a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-route-page="@i">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-route-page="@(Model.CurrentPage + 1)">&raquo;</a>
                </li>
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-route-page="@Model.TotalPages">&raquo;&raquo;</a>
                </li>
            </ul>
        </nav>
    </div>
</div>