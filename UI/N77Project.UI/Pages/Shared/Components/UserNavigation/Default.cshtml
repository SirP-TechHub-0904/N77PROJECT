@{
    List<Domain.Models.UserCategory> usergroups = ViewBag.userCategory;
}


@if (User.Identity.IsAuthenticated && User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("StateAdmin"))
{
    <li class="nav-header" style="background-color: #c8cacc;border-radius: 4px;font-weight: bolder;color: black;">ADMIN MENU</li>
    <li class="nav-item">
        <a asp-page="/Admin/Index" asp-area="Dashboard" class="nav-link">
            <i class="nav-icon fas fa-tree"></i>
            <p>
                Dashboard
            </p>
        </a>
    </li>
    @foreach(var item in usergroups) { 
    <li class="nav-item">
        <a asp-page="/UserGroupPage/GroupLists" asp-route-id="@item.Id" asp-area="User" class="nav-link">
            <i class="nav-icon fas fa-tree"></i>
            <p>
                @item.Title
            </p>
        </a>
    </li>
    }



    <li class="nav-item">
        <a asp-page="/Category/Index" asp-area="ITrainings" class="nav-link">
            <i class="nav-icon fas fa-tree"></i>
            <p>
                Trainings
            </p>
        </a>
    </li>
    
    @if (User.Identity.IsAuthenticated && User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
    {

        <li class="nav-item">
            <a asp-page="/TestQuestions/Index" asp-area="ITrainings" class="nav-link">
                <i class="nav-icon fas fa-table"></i>
                <p>
                    Test Questions
                </p>
            </a>
        </li>
        <li class="nav-item">
            <a asp-page="/EvaluationPage/Index" asp-area="ITrainings" class="nav-link">
                <i class="nav-icon fas fa-table"></i>
                <p>
                    Evaluation Questions
                </p>
            </a>
        </li>
       

        <li class="nav-item">
            <a asp-page="/Admin/ListParticipants" asp-area="User" class="nav-link">
                <i class="nav-icon fas fa-users"></i>
                <p>
                    Participants
                </p>
            </a>
        </li>
        <li class="nav-item">
            <a asp-page="/Admin/AllFacilitators" asp-area="User" class="nav-link">
                <i class="nav-icon fas fa-users-cog"></i>
                <p>
                    Faciliators
                </p>
            </a>
        </li>

        <li class="nav-item">
            <a asp-page="/Admin/Index" asp-area="User" class="nav-link">
                <i class="nav-icon fas fa-user-slash"></i>
                <p>
                    Users
                </p>
            </a>
        </li>
        <li class="nav-item">
            <a asp-page="/UserGroupPage/Index" asp-area="User" class="nav-link">
                <i class="nav-icon fas fa-user-slash"></i>
                <p>
                    User Groups
                </p>
            </a>
        </li>
         
        <li class="nav-item">
            <a asp-page="/Admin/Sponsors" asp-area="ITrainings" class="nav-link">
                <i class="nav-icon fas fa-plus-square"></i>
                <p>
                    Sponsors
                </p>
            </a>
        </li>
 
    }
 
    <li class="nav-item">
        <a asp-page="/Admin/UpdateSetting" asp-area="ITrainings" class="nav-link">
            <i class="nav-icon fas fa-users"></i>
            <p>
                Settings
            </p>
        </a>
    </li>
     


}

@if (User.Identity.IsAuthenticated && User.IsInRole("Participant") || User.IsInRole("Facilitator") || User.IsInRole("Supervisor"))
{


    <li class="nav-header" style="background-color: #c8cacc;border-radius: 4px;font-weight: bolder;color: black;">
        @if (User.IsInRole("Participant"))
        {
            <text>PARTICIPANT</text>
        }
        else if (User.IsInRole("Facilitator"))
        {
            <text>FACILITATOR</text>
        }


        MENU
